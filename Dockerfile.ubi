# --------------------------------------------------------------------------
# Dockerfile.ubi — Hermes Agent on Red Hat UBI 9 (OpenShift-compatible)
# --------------------------------------------------------------------------
# Adapted from the upstream debian:13.4-based Dockerfile.
# Uses ubi9/python-312 as the base (provides Python 3.12 + dnf).
# Node.js is installed via the ubi9 module stream.
# Runs as UID 1001 with GID 0 for OpenShift arbitrary-UID support.
# --------------------------------------------------------------------------

# ---- Source stage for uv binary ----
FROM ghcr.io/astral-sh/uv:0.11.6 AS uv_source

# ---- Main image ----
FROM registry.access.redhat.com/ubi9/python-312

# Disable Python stdout buffering to ensure logs are printed immediately
ENV PYTHONUNBUFFERED=1

# Store Playwright browsers outside the volume mount so the build-time
# install survives the /opt/data volume overlay at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

# Environment variables for deployment (values provided at runtime via K8s secrets)
ENV OPENAI_API_KEY="" \
    API_SERVER_KEY="" \
    API_SERVER_HOST="0.0.0.0"

# ---- Install system dependencies ----
# Switch to root for package installation
USER 0

# Enable Node.js 22 module stream and install system deps in one layer.
# UBI9 python-312 images use dnf (full UBI, not ubi-minimal).
RUN dnf module enable -y nodejs:22 && \
    dnf install -y --setopt=install_weak_deps=False \
        nodejs npm \
        gcc gcc-c++ make \
        libffi-devel python3-devel \
        procps-ng \
        git openssh-clients \
        findutils \
    && dnf clean all && rm -rf /var/cache/dnf

# Playwright Chromium runtime dependencies (RHEL/UBI equivalents).
RUN dnf install -y --setopt=install_weak_deps=False \
        nss \
        nspr \
        atk \
        at-spi2-atk \
        cups-libs \
        libdrm \
        libXcomposite \
        libXdamage \
        libXrandr \
        libXext \
        libXfixes \
        libxcb \
        libxkbcommon \
        mesa-libgbm \
        pango \
        alsa-lib \
        gtk3 \
        dbus-glib \
        libXcursor \
        libXi \
        libXtst \
        libXScrnSaver \
        xorg-x11-fonts-misc \
        xorg-x11-fonts-Type1 \
    && dnf clean all && rm -rf /var/cache/dnf

# Install tini from GitHub release (not packaged in UBI9 repos).
# tini reaps orphaned zombie processes (MCP stdio subprocesses, git, etc.)
# that would otherwise accumulate when hermes runs as PID 1.
RUN curl -fsSL https://github.com/krallin/tini/releases/download/v0.19.0/tini-amd64 \
        -o /usr/local/bin/tini && \
    chmod +x /usr/local/bin/tini

# Install ripgrep from GitHub release (not in UBI9 repos).
RUN curl -fsSL https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep-14.1.1-x86_64-unknown-linux-musl.tar.gz \
        | tar xz --strip-components=1 -C /usr/local/bin ripgrep-14.1.1-x86_64-unknown-linux-musl/rg && \
    chmod +x /usr/local/bin/rg

# Install ffmpeg from a static build (not in UBI9 repos).
# Used by voice/audio features (Discord voice, TTS Opus conversion, STT).
RUN curl -fsSL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz \
        -o /tmp/ffmpeg.tar.xz && \
    tar xJf /tmp/ffmpeg.tar.xz --strip-components=1 --wildcards -C /usr/local/bin '*/ffmpeg' '*/ffprobe' && \
    chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe && \
    rm -f /tmp/ffmpeg.tar.xz

# Copy uv/uvx from the official uv image.
COPY --chmod=0755 --from=uv_source /uv /uvx /usr/local/bin/

# Create the working directories and data volume mount point.
# /opt/data is the persistent state directory.
RUN mkdir -p /opt/hermes /opt/data && \
    chgrp -R 0 /opt/hermes /opt/data && \
    chmod -R g=u /opt/hermes /opt/data

WORKDIR /opt/hermes

# ---------- Layer-cached Node.js dependency install ----------
# Copy only package manifests first so npm install + Playwright are cached
# unless the lockfiles themselves change.
#
# ui-tui/packages/hermes-ink/ is copied IN FULL (not just its manifests)
# because it is referenced as a `file:` workspace dependency from
# ui-tui/package.json.
COPY package.json package-lock.json ./
COPY web/package.json web/package-lock.json web/
COPY ui-tui/package.json ui-tui/package-lock.json ui-tui/
COPY ui-tui/packages/hermes-ink/ ui-tui/packages/hermes-ink/

# Force npm to install `file:` deps as symlinks (see original Dockerfile for rationale)
ENV npm_config_install_links=false

# Install npm deps: root-level, then Playwright, then sub-workspaces.
RUN npm install --prefer-offline --no-audit && \
    npm cache clean --force

# Install Playwright Chromium browser (without --with-deps since OS libs
# were installed via dnf above).
RUN npx playwright install chromium --only-shell

# Install workspace npm deps (web + ui-tui).
RUN (cd web && npm install --prefer-offline --no-audit) && \
    (cd ui-tui && npm install --prefer-offline --no-audit) && \
    npm cache clean --force

# ---------- Layer-cached Python dependency install ----------
# Copy only pyproject.toml + uv.lock so the Python dep layer is cached
# unless those inputs change.
COPY pyproject.toml uv.lock ./
RUN touch ./README.md
RUN uv sync --frozen --no-install-project --extra all

# ---------- Source code ----------
# .dockerignore excludes node_modules, so the installs above survive.
COPY . .

# Build browser dashboard and terminal UI assets.
RUN cd web && npm run build && \
    cd ../ui-tui && npm run build

# ---------- Link hermes-agent itself (editable) ----------
# Deps are already installed in the cached layer above; --no-deps makes
# this a fast (~1s) egg-link creation with no resolution or downloads.
RUN uv pip install --no-cache-dir --no-deps -e "."

# ---------- Permissions (OpenShift arbitrary UID support) ----------
# Make the entrypoint script executable.
RUN chmod +x /opt/hermes/docker/entrypoint-openshift.sh

# Make install dir world-readable so any UID can read it at runtime.
# node_modules trees need to be writable for runtime npm install checks.
# Group 0 gets full access for OpenShift compatibility.
RUN chmod -R a+rX /opt/hermes && \
    chown -R 1001:0 /opt/hermes/ui-tui /opt/hermes/node_modules && \
    chgrp -R 0 /opt/hermes /opt/data && \
    chmod -R g=u /opt/hermes /opt/data

# ---------- Runtime ----------
ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
ENV HERMES_HOME=/opt/data
ENV PATH="/opt/data/.local/bin:${PATH}"
ENV HOME=/opt/data

VOLUME [ "/opt/data" ]

# Expose the gateway API server (8642) and dashboard (9119) ports
EXPOSE 8642
EXPOSE 9119

# Run as non-root user 1001 with group 0 for OpenShift
RUN chgrp -R 0 /opt/app-root/src/node_modules && chmod -R g=u /opt/app-root/src/node_modules || true
USER 1001

ENTRYPOINT [ "/usr/local/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint-openshift.sh" ]
CMD [ "gateway", "run" ]
